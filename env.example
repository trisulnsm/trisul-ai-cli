# Copy to config/.env and fill in the same values the pip CLI stores.
# Do not commit the filled file. The Docker image never contains this file.

TRISUL_AI_PROVIDER=gemini
TRISUL_AI_MODEL=gemini-3.6-flash
TRISUL_GEMINI_API_KEY=
# TRISUL_OPENAI_API_KEY=
# TRISUL_ANTHROPIC_API_KEY=
# TRISUL_CUSTOM_API_BASE_URL=http://host.docker.internal:11434
# TRISUL_CUSTOM_API_KEY=not-needed
TRISUL_EMBEDDING_PROVIDER=gemini
TRISUL_EMBEDDING_MODEL=models/gemini-embedding-001
TRISUL_AI_MAX_TOKENS=16384
